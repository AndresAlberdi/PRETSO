# Path to the GCP service account JSON key file.
# Leave empty to use Application Default Credentials (e.g. on Cloud Run).
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase / GCP project ID
FIREBASE_PROJECT_ID=your-gcp-project-id

# Comma-separated list of allowed CORS origins.
# Use * for development (allows all origins).
ALLOWED_ORIGINS=*

# Minimum number of published records required to activate the public portal.
LAUNCH_THRESHOLD=20
