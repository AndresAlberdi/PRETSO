# Variables de entorno para desarrollo local. Copie este archivo a .env.development.local (ignorado por git).
#
# Token de depuración de App Check: solo para `npm run dev`. Se registra en la consola de Firebase
# (App Check) del proyecto pretso-database. Es un secreto: no lo versione ni lo use en CI. Solo se
# admite en `npm run dev` (servidor de desarrollo local, modo development): cualquier build (en cualquier modo)
# o prueba falla si esta variable tiene valor.
VITE_APPCHECK_DEBUG_TOKEN=
