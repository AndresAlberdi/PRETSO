rules_version = '2';
// ============================================================================
// Reglas endurecidas de PRETSO (estándar DevSecOps v2.0)
// Documento de referencia: SeguridadGeneral/01-seguridad/03-hardening-por-nube.md
//
// Requisito previo al despliegue: el custom claim `admin` debe estar asignado
// en el proyecto (scripts/asignar_claim_admin.py); de lo contrario nadie escribe.
//
// Qué corrige respecto de las reglas anteriores:
// 1. El privilegio de escritura deja de depender de un correo escrito de forma
//    fija ('pretsodatabase@gmail.com') y pasa a un custom claim `admin` que se
//    administra desde el backend sin editar ni redesplegar reglas.
// 2. La lectura deja de ser «cualquier usuario autenticado»: con el registro
//    abierto por la apiKey pública, cualquiera podría leer todo. Ahora exige
//    administrador o el claim `reader` (función lector()); `logs` y `users`
//    solo los lee el administrador.
//
// Pendiente: la lectura por colección (principio de menor privilegio) sigue sin
// declararse; el bloque global `{document=**}` existe, pero restringido a
// lector().
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      // El claim se asigna una sola vez con el Admin SDK (PILOTO.md, paso 7):
      //   admin.auth().setCustomUserClaims(uid, { admin: true })
      return autenticado() && request.auth.token.admin == true;
    }

    function lector() {
      return esAdmin() || request.auth.token.reader == true;
    }

    // Las reglas de `match` solapados se suman (basta que una permita), así
    // que el bloque global debe excluir explícitamente `logs` y `users`.
    function coleccionReservada() {
      return request.path[3] in ['logs', 'users'];
    }

    // ------------------------------------------------------------------
    // Declare aquí las colecciones reales del proyecto (ver
    // estructura_datos.md) y elimine este bloque genérico cuando lo haga.
    // Mientras tanto la lectura exige lector() y la escritura solo administrador
    // (claim en lugar de correo fijo).
    // ------------------------------------------------------------------
    match /logs/{document=**} {
      allow read: if esAdmin();
      allow create, update: if esAdmin();
      allow delete: if esAdmin();
    }

    match /users/{document=**} {
      allow read: if esAdmin();
      allow create, update: if esAdmin();
      allow delete: if esAdmin();
    }

    match /{document=**} {
      allow read: if esAdmin() || (lector() && !coleccionReservada());
      allow create, update: if esAdmin();
      allow delete: if esAdmin();
    }
  }
}
